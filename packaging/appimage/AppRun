#!/bin/bash
# AppRun for Sonus AppImage.
# Bootstraps the runtime environment so that:
#  1. ALSA finds the bundled inferno PCM plugin (cannot live in /usr/lib/...).
#  2. systemd user units are seeded into ~/.config/systemd/user/ on first run.
#  3. Statime gets cap_sys_time once via pkexec or sudo (interactive prompt).
#  4. The bundled `sonus` CLI is the entry point; `sonus-gtk` invokes the GUI.
set -euo pipefail

HERE="$(cd "$(dirname "$(readlink -f "${0}")")" && pwd)"
export APPDIR="${HERE}"

# 1. ALSA plugin path workaround --------------------------------------------
export ALSA_PLUGIN_DIR="${APPDIR}/usr/lib/alsa-lib"
mkdir -p "${HOME}/.config/alsa"
APPIMAGE_ASOUNDRC="${HOME}/.config/alsa/sonusgrid-appimage.conf"
cat > "${APPIMAGE_ASOUNDRC}" <<EOF
# Auto-generated by Sonus AppImage. Do not edit.
pcm_type.inferno {
    lib "${ALSA_PLUGIN_DIR}/libasound_module_pcm_inferno.so"
}
EOF

# Insert idempotent block in ~/.asoundrc
ASOUNDRC="${HOME}/.asoundrc"
BEGIN="# >>> sonusgrid appimage  (managed; do not edit between markers)"
END="# <<< sonusgrid appimage"
if [ -f "${ASOUNDRC}" ] && grep -qF "${BEGIN}" "${ASOUNDRC}"; then
    awk -v begin="${BEGIN}" -v end="${END}" -v conf="${APPIMAGE_ASOUNDRC}" '
        $0 == begin {skip=1; print begin; print "<" conf ">"; print end; next}
        $0 == end {skip=0; next}
        skip != 1 {print}
    ' "${ASOUNDRC}" > "${ASOUNDRC}.tmp" && mv "${ASOUNDRC}.tmp" "${ASOUNDRC}"
else
    {
        [ -f "${ASOUNDRC}" ] && cat "${ASOUNDRC}" && echo
        echo "${BEGIN}"
        echo "<${APPIMAGE_ASOUNDRC}>"
        echo "${END}"
    } > "${ASOUNDRC}.tmp" && mv "${ASOUNDRC}.tmp" "${ASOUNDRC}"
fi

# 2. Stage Statime where setcap can be applied (squashfs is read-only) ------
SONUS_BIN_DIR="${HOME}/.cache/sonusgrid/bin"
mkdir -p "${SONUS_BIN_DIR}"
cp -f "${APPDIR}/usr/libexec/sonusgrid/statime" "${SONUS_BIN_DIR}/statime"
cp -f "${APPDIR}/usr/bin/sonusgrid" "${SONUS_BIN_DIR}/sonusgrid"

# Ensure cap_sys_time on the staged statime. Try pkexec first; fall back to
# sudo. If neither is available, print instructions and proceed (Statime will
# fail to set the clock but the user gets a usable error).
if ! getcap "${SONUS_BIN_DIR}/statime" 2>/dev/null | grep -q cap_sys_time; then
    if command -v pkexec >/dev/null; then
        pkexec setcap cap_sys_time,cap_net_bind_service,cap_net_admin+ep \
            "${SONUS_BIN_DIR}/statime" || true
    elif command -v sudo >/dev/null; then
        echo "sudo password needed once to grant Statime cap_sys_time:"
        sudo setcap cap_sys_time,cap_net_bind_service,cap_net_admin+ep \
            "${SONUS_BIN_DIR}/statime" || true
    fi
fi

# 3. systemd user units, paths rewritten to point at ~/.cache/sonus/bin -----
USER_UNIT_DIR="${HOME}/.config/systemd/user"
mkdir -p "${USER_UNIT_DIR}/pipewire.service.d"
for unit in sonusgrid-clock.service sonusgrid-audio.service; do
    sed "s|/usr/bin/sonusgrid|${SONUS_BIN_DIR}/sonusgrid|g" \
        "${APPDIR}/usr/lib/systemd/user/${unit}" \
        > "${USER_UNIT_DIR}/${unit}"
done
cp -f "${APPDIR}/usr/lib/systemd/user/pipewire.service.d/sonusgrid-clock.conf" \
    "${USER_UNIT_DIR}/pipewire.service.d/sonusgrid-clock.conf"
systemctl --user daemon-reload || true

# 4. Make `sonusgrid` reachable for the GUI subprocess calls ---------------
export PATH="${SONUS_BIN_DIR}:${APPDIR}/usr/bin:${PATH}"

# 5. Dispatch ---------------------------------------------------------------
export PYTHONPATH="${APPDIR}/usr/share/sonusgrid/gui:${PYTHONPATH:-}"

case "${1:-gui}" in
    gui|"")
        exec python3 -m sonus_gtk
        ;;
    cli)
        shift
        exec "${SONUS_BIN_DIR}/sonusgrid" "$@"
        ;;
    *)
        exec "${SONUS_BIN_DIR}/sonusgrid" "$@"
        ;;
esac
